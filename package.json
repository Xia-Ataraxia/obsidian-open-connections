{
  "name": "open-connections",
  "version": "3.9.47",
  "type": "module",
  "bin": {
    "open-connections-mcp": "dist/mcp.js"
  },
  "packageManager": "pnpm@10.28.2",
  "description": "Link and chat with your notes using ChatGPT and embedding artificial intelligence from OpenAI.",
  "scripts": {
    "build": "node esbuild.js",
    "build:watch": "node esbuild.js --watch",
    "dev": "node scripts/dev.mjs",
    "dev:build": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:watch": "tsc --noEmit -p tsconfig.typecheck.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:test-vault": "node scripts/verify-test-vault.mjs",
    "verify:vault-freshness": "node scripts/check-vault-build-freshness.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "version": "node scripts/version.mjs",
    "postversion": "git push && git push --tags",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepare": "husky",
    "profile:scaling": "node scripts/profile-scaling.mjs",
    "profile:freeze-flows": "node scripts/profile-freeze-flows.mjs",
    "profile:live-vault": "node scripts/profile-live-vault.mjs",
    "profile:state-latency": "node scripts/profile-state-latency.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoBeromsu/Open-smart-connections.git"
  },
  "keywords": [
    "Obsidian",
    "Smart",
    "Connections",
    "AI",
    "ChatGPT",
    "Embeddings",
    "Notes"
  ],
  "author": "Beomsu Koh",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/GoBeromsu/Open-smart-connections/issues"
  },
  "homepage": "https://github.com/GoBeromsu/Open-smart-connections",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@xenova/transformers": "latest",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "swagger-jsdoc": "^6.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "base64-js": "^1.5.1",
    "js-tiktoken": "^1.0.21",
    "lucide-static": "^1.61.0",
    "node-fetch": "^3.3.2",
    "obsidian": "latest"
  }
}
