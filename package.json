{
	"name": "obsidian-open-connections",
	"version": "3.10.2",
	"type": "module",
	"description": "Link and chat with your notes using ChatGPT and embedding artificial intelligence from OpenAI.",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"ci": "bun run build && bun run typecheck && bun run lint && bun run test",
		"release": "curl -fsSL https://raw.githubusercontent.com/GoBeromsu/obsidian-boiler-template/main/scripts/release.ts | bun run -"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Xia-Ataraxia/obsidian-open-connections.git"
	},
	"keywords": [
		"Obsidian",
		"Smart",
		"Connections",
		"AI",
		"ChatGPT",
		"Embeddings",
		"Notes"
	],
	"author": "Beomsu Koh",
	"license": "SEE LICENSE IN LICENSE",
	"bugs": {
		"url": "https://github.com/Xia-Ataraxia/obsidian-open-connections/issues"
	},
	"homepage": "https://github.com/Xia-Ataraxia/obsidian-open-connections#readme",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "^26.6.5",
		"@vitest/eslint-plugin": "^1.6.28",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"js-tiktoken": "^1.0.21"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
